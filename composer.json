{
    "name": "shootalert/shootalert-laravel",
    "description": "Laravel SDK for ShootAlert: ships uncaught exceptions to the platform with breadcrumbs and request context.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "error-tracking", "exceptions", "monitoring", "shootalert"],
    "require": {
        "php": "^8.0",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "monolog/monolog": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "ShootAlert\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ShootAlert\\Laravel\\ShootAlertServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
